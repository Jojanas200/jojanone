# -----------------------------------------------------------------------------
# Jojan One - environment variables (copy to .env.local and fill in)
#
# Every integration is "build-now, keys-later": the app runs with these blank
# and each feature turns on when its key is added. Only DATABASE_URL, DIRECT_URL
# and the Supabase keys are required to boot with real data.
# -----------------------------------------------------------------------------

# --- Database (Drizzle) ------------------------------------------------------
# App runtime connection. Behind Supabase's TRANSACTION POOLER (port 6543) the
# client sets prepare:false automatically (see src/server/db/client.ts).
# Local Supabase:  postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Hosted (pooler): postgresql://postgres.<ref>:<password>@aws-0-eu-west-2.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# DIRECT (non-pooled) connection - used by `drizzle-kit pull`, migrations (psql)
# and the verify-* scripts. Local: same as DATABASE_URL. Hosted: port 5432.
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Supabase (Auth on the client; keys for server-side admin work) ----------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---------------------------------------------------------------------
# Public base URL, used for Stripe redirect/return URLs and email links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Platform-admin (Jojan One management) access. NOT a database role.
#   PLATFORM_ADMIN_EMAILS   = OPERATORS - full access (suspend, impersonate,
#                             billing overrides, settings, user admin).
#   PLATFORM_ANALYST_EMAILS = ANALYSTS  - read-only /admin access.
# Comma-separated. Operator wins if an email is in both lists.
PLATFORM_ADMIN_EMAILS=
PLATFORM_ANALYST_EMAILS=
# Shared secret for the cron endpoints (Authorization: Bearer <secret>).
CRON_SECRET=

# --- AI provider (Jova) - one active at a time; chosen in /admin/settings -----
# AI_PROVIDER=anthropic | openrouter (env is the fallback; the DB setting wins)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Billing (Stripe) --------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs for the sellable plans (Stripe Dashboard > Products).
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=

# --- Email (invites + reminder digests) --------------------------------------
# EMAIL_PROVIDER=resend | console (console just logs; no delivery)
EMAIL_PROVIDER=console
RESEND_API_KEY=
# From address for outbound mail, e.g. "Jojan One <hello@yourdomain.co.uk>"
EMAIL_FROM=

# --- Companies House ---------------------------------------------------------
COMPANIES_HOUSE_API_KEY=

# --- Redis: rate limiting + caching (build-now, keys-later) ------------------
# Either naming convention is accepted; REST is preferred (serverless-native).
#
# REST (Upstash or Vercel KV - HTTP, no persistent socket):
#   Vercel KV:  KV_REST_API_URL + KV_REST_API_TOKEN
#   Upstash:    UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN
# TCP (self-hosted / managed redis://, via ioredis):
#   Regular:    REDIS_URL
#   Vercel TCP: KV_URL
#
# Rate limiting uses UPSTASH_REDIS_REST_* specifically; the cache accepts any of
# the below. With none set, rate limiting is in-memory best-effort and the cache
# is a no-op (loaders run directly).
REDIS_URL=
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
