  "faq": {
    "title": "Frequently asked questions",
    "items": [
      {
        "id": "faq1",
        "question": "What do I get during my free trial?",
        "answer": "Your 14-day free trial includes full access to the Growth Plan, allowing you to experience Jojan One's advanced compliance, governance, AI, reporting and business intelligence features."
      },
      {
        "id": "faq2",
        "question": "Do I need a credit card?",
        "answer": "No. You can start your free trial without providing any payment details."
      },
      {
        "id": "faq3",
        "question": "What happens after my trial ends?",
        "answer": "At the end of your 14-day trial, you can choose the subscription plan that best fits your business: Starter – Business Protection Essentials, Growth – Complete Business Protection, or Scale – Enterprise Business Protection. If you choose not to subscribe immediately, your account will become inactive until you select a plan. Your data will remain securely stored in accordance with our data retention policy."
      },
      {
        "id": "faq4",
        "question": "Can I upgrade at any time?",
        "answer": "Yes. You can upgrade your subscription whenever your business requires additional users, advanced intelligence, automation or enterprise capabilities."
      },
      {
        "id": "faq5",
        "question": "Can I change plans at any time?",
        "answer": "Yes. You can upgrade or downgrade your plan at any time. Changes take effect at the start of your next billing period."
      },
      {
        "id": "faq6",
        "question": "What counts as a user?",
        "answer": "A user is anyone with a login to your Jojan One account, including team members, directors and advisors you invite."
      },
      {
        "id": "faq7",
        "question": "Do you offer annual billing?",
        "answer": "Yes. Annual billing is available at a 20% discount. Contact us to switch to annual billing."
      },
      {
        "id": "faq8",
        "question": "What happens to my data if I cancel?",
        "answer": "Your data remains accessible for 30 days after cancellation. You can export everything before your account closes."
      },
      {
        "id": "faq9",
        "question": "Is Jojan One suitable for my industry?",
        "answer": "Jojan One is designed for SMEs across all sectors. Jova tailors compliance monitoring and document generation to your specific industry and jurisdiction."
      }
    ]
  },
